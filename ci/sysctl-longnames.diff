+/*
+ * Append s to the string in *p, of *szp bytes, growing it as needed.
+ */
+static int
+__sysctl_pcat(char **p, size_t *szp, const char *s)
+{
+	size_t need = strlen(*p) + strlen(s) + 1;
+	char *np;
+
+	if (need > *szp) {
+		if ((np = realloc(*p, need)) == NULL)
+			return (-1);
+		*p = np;
+		*szp = need;
+	}
+	strlcat(*p, s, *szp);
+	return (0);
+}
+
+/*
+ * Whether buf, of len bytes, is SYSCTL_VERS_2 records end to end, each
+ * long enough for its name and ending its name with a nul, so that
+ * NEXT_SYSCTLREC() and rec_name can be used without further checks.
+ */
+static int
+__sysctl_recs_ok(const void *buf, size_t len)
+{
+	const struct sysctlrec *r;
+	const char *p = buf, *end = p + len;
+
+	while (p < end) {
+		if ((size_t)(end - p) < offsetof(struct sysctlrec, rec_name))
+			return (-1);
+		r = (const void *)p;
+		if (r->rec_namelen == 0 ||
+		    r->rec_namelen > (size_t)(end - p) ||
+		    r->rec_len < __sysc_rec_len(r->rec_namelen) ||
+		    r->rec_len > (size_t)(end - p) ||
+		    (r->rec_len & 7) != 0 ||
+		    r->rec_name[r->rec_namelen - 1] != '\0')
+			return (-1);
+		p += r->rec_len;
+	}
+	return (0);
+}
