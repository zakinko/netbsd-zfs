+
+/*
+ * The children of the node at name, as the SYSCTL_VERS_2 records of
+ * <sys/sysctl.h>, in memory from malloc(3) that the caller frees; *lenp
+ * is set to the bytes in it.  A kernel that does not know the records
+ * is asked for SYSCTL_VERS_1 nodes, which are made into records with
+ * the names they have.
+ *
+ * It is here and not with asysctl(3) because the rump programs build
+ * this file to talk to a rump kernel, and need this to do so too.
+ */
+void *
+asysctlquery(const int *name, size_t namelen, size_t *lenp)
+{
+	int qname[CTL_MAXNAME + 1];
+	struct sysctlrec q, *r;
+	struct sysctlnode qn, *n1;
+	size_t sz, i, nl, c1;
+	char *buf, *p;
+
+	if (namelen >= CTL_MAXNAME) {
+		errno = EINVAL;
+		return (NULL);
+	}
+	memcpy(qname, name, namelen * sizeof(int));
+	qname[namelen] = CTL_QUERY;
+
+	memset(&q, 0, sizeof(q));
+	q.rec_node.sysctl_flags = SYSCTL_VERS_2;
+	q.rec_namelen = 1;
+	q.rec_len = (uint32_t)__sysc_rec_len(1);
+	buf = __sysctl_querybuf(qname, (u_int)namelen + 1, &q, q.rec_len, &sz);
+	if (buf != NULL) {
+		if (__sysctl_recs_ok(buf, sz) == -1) {
+			free(buf);
+			errno = EINVAL;
+			return (NULL);
+		}
+		*lenp = sz;
+		return (buf);
+	}
+	if (errno != EINVAL)
+		return (NULL);
+
+	memset(&qn, 0, sizeof(qn));
+	qn.sysctl_flags = SYSCTL_VERS_1;
+	buf = __sysctl_querybuf(qname, (u_int)namelen + 1, &qn, sizeof(qn),
+	    &sz);
+	if (buf == NULL)
+		return (NULL);
+
+	/*
+	 * an older kernel: make records of the nodes
+	 */
+	n1 = (void *)buf;
+	c1 = sz / sizeof(*n1);
+	for (sz = 0, i = 0; i < c1; i++)
+		sz += __sysc_rec_len(strlen(n1[i].sysctl_name) + 1);
+	if ((p = calloc(1, sz + 1)) == NULL) {
+		free(buf);
+		return (NULL);
+	}
+	for (r = (void *)p, i = 0; i < c1; i++, r = NEXT_SYSCTLREC(r)) {
+		nl = strlen(n1[i].sysctl_name) + 1;
+		r->rec_node = n1[i];
+		r->rec_len = (uint32_t)__sysc_rec_len(nl);
+		r->rec_namelen = (uint32_t)nl;
+		memcpy(r->rec_name, n1[i].sysctl_name, nl);
+	}
+	free(buf);
+	*lenp = sz;
+	return (p);
+}
