+/*
+ * The whole name of node, a child of the node at name.  A name shorter
+ * than SYSCTL_NAMELEN - 1 bytes is whole as it is; for a longer one the
+ * children's records are fetched once into *recs, for the caller to
+ * free, and the name is taken from there.  NULL if it cannot be had:
+ * the name in the node may be cut short, and comparing that could match
+ * the wrong node.
+ */
+static const char *
+__sysctl_fullname(const int *name, u_int namelen,
+    const struct sysctlnode *node, void **recs, size_t *rlen)
+{
+	struct sysctlrec *r, *end;
