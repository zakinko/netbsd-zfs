+static void *
+__sysctl_querybuf(const int *qname, u_int qlen, const void *q, size_t qsz,
+    size_t *szp)
+{
+	void *buf = NULL;
+	size_t sz;
+
+	for (;;) {
+		sz = 0;
+		if (sysctl(qname, qlen, NULL, &sz, q, qsz) == -1)
+			break;
+		free(buf);
+		if ((buf = malloc(sz + 1)) == NULL)
+			return (NULL);
+		if (sysctl(qname, qlen, buf, &sz, q, qsz) == 0) {
+			*szp = sz;
+			return (buf);
+		}
+		if (errno != ENOMEM)	/* ENOMEM: it grew meanwhile */
+			break;
+	}
+	free(buf);
+	return (NULL);
