+static int
+vnd_check_idle(void)
+{
+	device_t dv;
+	struct vnd_softc *sc;
+	int error = 0, unit;
+
+	for (unit = 0; error == 0 && unit < vnd_cd.cd_ndevs; unit++) {
+		if ((dv = device_lookup_acquire(&vnd_cd, unit)) == NULL)
+			continue;
+		sc = device_private(dv);
+		if ((sc->sc_flags & VNF_INITED) != 0 ||
+		    sc->sc_dkdev.dk_openmask != 0)
+			error = EBUSY;
+		device_release(dv);
+	}
+	return error;
+}
+
+/* Destroy the units left by vnd_acquire(), if none of them is in use. */
+static int
+vnd_destroy_idle(void)
+{
+	device_t dv;
+	struct vnd_softc *sc;
+	int error, unit;
+
+	for (unit = 0; unit < vnd_cd.cd_ndevs; unit++) {
+		if ((dv = device_lookup_acquire(&vnd_cd, unit)) == NULL)
+			continue;
+		sc = device_private(dv);
+		if ((sc->sc_flags & VNF_INITED) != 0 ||
+		    sc->sc_dkdev.dk_openmask != 0) {
+			device_release(dv);
+			return EBUSY;
+		}
+		if ((error = vnd_destroy(dv)) != 0)
+			return error;
+	}
+	return 0;
+}
