+/*
+ * Find a unit, or make one, and hold it until vnd_release().  vndlock()
+ * cannot do this: it lives in the softc, and vndclose() used to free
+ * that with no regard for an open sleeping there, or for a partition
+ * still open, as soon as it had seen the unit unconfigured.  Opening
+ * /dev/vnd0d and /dev/rvnd0d from two threads was enough.
+ */
+static struct vnd_softc *
+vnd_acquire(int unit, bool spawn)
+{
+	struct vnd_softc *sc;
+
+	mutex_enter(&vnd_device_lock);
+	sc = device_lookup_private(&vnd_cd, unit);
+	if (sc == NULL && spawn) {
+		sc = vnd_spawn(unit);
+		if (sc != NULL) {
+			/* compatibility, keep disklabel after close */
+			sc->sc_flags = VNF_KLABEL;
+		}
+	}
+	if (sc != NULL)
+		sc->sc_refs++;
+	mutex_exit(&vnd_device_lock);
+	return sc;
+}
+
+/*
+ * Let go of a unit, the last one out destroying it if it is not
+ * configured and nothing has it open.
+ */
 static int
+vnd_release(struct vnd_softc *sc)
+{
+	int error = 0;
+
+	mutex_enter(&vnd_device_lock);
+	if (--sc->sc_refs == 0 && (sc->sc_flags & VNF_INITED) == 0 &&
+	    sc->sc_dkdev.dk_openmask == 0) {
+		if ((error = vnd_destroy(sc->sc_dev)) != 0)
+			aprint_error_dev(sc->sc_dev,
+			    "unable to detach instance\n");
+	}
+	mutex_exit(&vnd_device_lock);
+	return error;
+}
