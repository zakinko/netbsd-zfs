 	uint64_t	who;
@@ -1327,6 +1349,7 @@ zfs_acl_chmod(vtype_t vtype, uint64_t mode, boolean_t split, boolean_t trim,
 	size_t 		abstract_size = aclp->z_ops->ace_abstract_size();
 	void 		*zacep;
 	boolean_t	isdir;
+	boolean_t	owner_rights = B_FALSE;
