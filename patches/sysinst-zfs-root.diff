+#ifdef HAVE_ZFS_ROOT
+/*
+ * Fill the boot partition of a ZFS root and write a boot.cfg that
+ * loads the zfs modules and the root ramdisk from it.  The boot.cfg
+ * the etc set put on the ZFS root is out of the boot loader's reach.
+ */
+static int
+zfs_root_boot_cfg(struct install_partition_desc *install)
+{
+	static const char zfs_boot[] =
+	    "load solaris;load zfs;fs /" ZFS_ROOT_RAMDISK ";boot";
+	FILE *f;
+	int ret;
+
+	ret = zfs_root_post_extract(install);
+	if (ret != 0)
+		return ret;
+
+	f = target_fopen(ZFS_BOOT_MOUNT "/boot.cfg", "w");
+	if (f == NULL)
+		return 1;
+	scripting_fprintf(NULL, "cat <<EOF >%s" ZFS_BOOT_MOUNT "/boot.cfg\n",
+	    target_prefix());
+	scripting_fprintf(f, "banner=Welcome to NetBSD\n");
+	scripting_fprintf(f, "banner=Root file system is %s/%s (ZFS)\n",
+	    ZFS_ROOT_POOL, ZFS_ROOT_FS);
+	scripting_fprintf(f, "banner=Kernel and modules are in the boot "
+	    "partition, mounted as %s\n", ZFS_BOOT_MOUNT);
+	scripting_fprintf(f, "banner=\n");
+	scripting_fprintf(f, "menu=Boot normally:%s\n", zfs_boot);
+	scripting_fprintf(f, "menu=Boot single user:%s -s\n", zfs_boot);
+	scripting_fprintf(f, "menu=Drop to boot prompt:prompt\n");
+	scripting_fprintf(f, "default=1\n");
+	scripting_fprintf(f, "timeout=5\n");
+	scripting_fprintf(f, "clear=1\n");
+	scripting_fprintf(NULL, "EOF\n");
+	fclose(f);
+	return 0;
+}
+#endif
