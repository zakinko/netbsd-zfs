+/*
+ * Root on ZFS.
+ *
+ * The boot loader can not read ZFS, so the root pool is paired with a
+ * small FFS boot partition holding the kernel, the solaris and zfs
+ * modules and the ramdisk-zfsroot.fs image from the release.  The
+ * ramdisk imports the pool, mounts ZFS_ROOT_POOL/ZFS_ROOT_FS on
+ * /altroot and points init.root at it; that is where the names used
+ * here come from (see distrib/common/zfsroot.rc).  The boot partition
+ * stays reachable from the installed system as ZFS_BOOT_MOUNT.
+ */
+
+#include <sys/sysctl.h>
+#include <string.h>
+
+#include "defs.h"
+#include "msg_defs.h"
+
+/*
+ * Set once the root pool has been created, so the code that runs
+ * after the sets are extracted (and no longer has the partition
+ * description at hand) knows to fetch the ramdisk.
+ */
+bool zfs_root_install;
+
+static const char zfs_ramdisk_subdir[] = "installation/ramdisk";
+static const char zfs_sets_subdir[] = "binary/sets";
+
+#ifdef HAVE_GPT
+extern const struct disk_partitioning_scheme gpt_parts;
+#endif
+
+/*
+ * Do we have what a ZFS root needs on the install medium?
+ */
+bool
+zfs_root_available(void)
+{
+
+	check_available_binaries();
+	return have_zfs;
+}
+
+/*
+ * The ramdisk finds the pool with zpool import, which on NetBSD only
+ * scans whole disks and wedges, so the pool partition has to be one
+ * the kernel turns into a wedge by itself: a GPT one.  A disklabel
+ * partition would need DKWEDGE_METHOD_BSDLABEL, which GENERIC lacks.
+ */
+bool
+zfs_root_scheme_ok(const struct disk_partitions *parts)
+{
+
+#ifdef HAVE_GPT
+	return parts->pscheme == &gpt_parts;
+#else
+	return false;
+#endif
+}
+
+/*
+ * The partition that will be mounted as / on ZFS, or NULL.
+ */
+struct part_usage_info *
+zfs_root_part(struct install_partition_desc *install)
+{
+	size_t i;
+
+	for (i = 0; i < install->num; i++) {
+		if (install->infos[i].fs_type == FS_ZFS &&
+		    strcmp(install->infos[i].mount, "/") == 0)
+			return &install->infos[i];
+	}
+	return NULL;
+}
+
+/*
+ * The FFS boot partition belonging to a ZFS root, or NULL.
+ */
+struct part_usage_info *
+zfs_boot_part(struct install_partition_desc *install)
+{
+	size_t i;
+
+	for (i = 0; i < install->num; i++) {
+		if ((install->infos[i].instflags & PUIINST_BOOT) &&
+		    (install->infos[i].instflags & PUIINST_MOUNT) &&
+		    install->infos[i].fs_type == FS_BSDFFS &&
+		    strcmp(install->infos[i].mount, ZFS_BOOT_MOUNT) == 0)
+			return &install->infos[i];
+	}
+	return NULL;
+}
+
+/*
+ * A ZFS root only works with the boot partition next to it.
+ */
+bool
+zfs_root_check_partitions(struct install_partition_desc *install)
+{
+
+	if (zfs_root_part(install) == NULL)
+		return true;
+	if (!zfs_root_available()) {
+		hit_enter_to_continue(NULL, MSG_zfs_root_unavailable);
+		return false;
+	}
+	if (zfs_boot_part(install) == NULL) {
+		hit_enter_to_continue(NULL, MSG_zfs_root_no_boot_part);
+		return false;
+	}
+	if (!zfs_root_scheme_ok(zfs_root_part(install)->parts)) {
+		hit_enter_to_continue(NULL, MSG_zfs_root_needs_gpt);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Create the root pool on the partition's device and mount the root
+ * file system, the equivalent of newfs and mount for other types.
+ * The pool itself is not mounted anywhere (the install medium may
+ * well be read-only), ZFS_ROOT_FS uses a legacy mount point so
+ * mount(8) and the ramdisk can deal with it.
+ */
+int
+zfs_root_setup(struct part_usage_info *ptn, const char *dev)
+{
+	int error;
+
+	if (ptn->instflags & PUIINST_NEWFS) {
+		error = run_program(RUN_DISPLAY | RUN_PROGRESS,
+		    "/sbin/zpool create -f -m none -o cachefile=none %s %s",
+		    ZFS_ROOT_POOL, dev);
+		if (error != 0)
+			return error;
+		error = run_program(RUN_DISPLAY | RUN_PROGRESS,
+		    "/sbin/zfs create -o mountpoint=legacy %s/%s",
+		    ZFS_ROOT_POOL, ZFS_ROOT_FS);
+		if (error != 0)
+			return error;
+		ptn->instflags &= ~PUIINST_NEWFS;
+	}
+
+	if (partman_go == 0 && (ptn->instflags & PUIINST_MOUNT)) {
+		char fs[STRSIZE];
+
+		snprintf(fs, sizeof fs, "%s/%s", ZFS_ROOT_POOL, ZFS_ROOT_FS);
+		make_target_dir(ptn->mount);
+		error = target_mount_do("-t zfs", fs, ptn->mount);
+		if (error != 0) {
+			msg_display_subst(MSG_mountfail, 2, fs, ptn->mount);
+			hit_enter_to_continue(NULL, NULL);
+			return error;
+		}
+	}
+
+	zfs_root_install = true;
+	return 0;
+}
+
+/*
+ * The ramdisk lives in installation/ramdisk of the release, next to
+ * the binary/sets directory the sets came from.  Turn one into the
+ * other; fails if the sets directory is not the release layout.
+ */
+static bool
+zfs_ramdisk_dir(char *buf, size_t len, const char *setsdir)
+{
+	size_t slen = strlen(setsdir), suflen = strlen(zfs_sets_subdir);
+
+	while (slen > 0 && setsdir[slen - 1] == '/')
+		slen--;
+	if (slen < suflen ||
+	    strncmp(setsdir + slen - suflen, zfs_sets_subdir, suflen) != 0)
+		return false;
+	snprintf(buf, len, "%.*s%s", (int)(slen - suflen), setsdir,
+	    zfs_ramdisk_subdir);
+	return true;
+}
+
+/*
+ * Put the ramdisk into the target's boot partition.  Called while
+ * the distribution medium is still mounted, right after the sets.
+ * Fetched sets come via ftp into xfer_dir; local media have the
+ * release directory at hand.
+ */
+int
+zfs_root_get_ramdisk(void)
+{
+	char dir[STRSIZE], src[STRSIZE], dest[STRSIZE];
+
+	snprintf(dest, sizeof dest, "%s/%s", ZFS_BOOT_MOUNT, ZFS_ROOT_RAMDISK);
+
+	if (fetch_fn != NULL) {
+		if (!zfs_ramdisk_dir(dir, sizeof dir, set_dir_bin) ||
+		    ftp_fetch_file(dir, ZFS_ROOT_RAMDISK) != SET_OK)
+			goto missing;
+		snprintf(src, sizeof src, "%s/%s", xfer_dir, ZFS_ROOT_RAMDISK);
+		if (!target_file_exists_p(src))
+			goto missing;
+		mv_within_target_or_die(src, dest);
+		return 0;
+	}
+
+	if (!zfs_ramdisk_dir(dir, sizeof dir, ext_dir_bin))
+		goto missing;
+	snprintf(src, sizeof src, "%s/%s", dir, ZFS_ROOT_RAMDISK);
+	if (!file_exists_p(src))
+		goto missing;
+	return cp_to_target(src, dest);
+
+missing:
+	msg_display_subst(MSG_zfs_root_no_ramdisk, 1, ZFS_ROOT_RAMDISK);
+	hit_enter_to_continue(NULL, NULL);
+	return 1;
+}
+
+/*
+ * After the sets are in: the boot loader needs the kernel and the two
+ * modules on the boot partition, the rest of the modules are loaded
+ * from the ZFS root once init has chrooted there.  The kernel we run
+ * is the one we install, so it knows where the modules set put them.
+ */
+int
+zfs_root_post_extract(struct install_partition_desc *install)
+{
+	static const char *modules[] = { "solaris", "zfs" };
+	char modbase[STRSIZE], moddir[STRSIZE], src[STRSIZE], dest[STRSIZE];
+	size_t i, len;
+	int error;
+
+	if (zfs_boot_part(install) == NULL)
+		return 0;
+
+	error = cp_within_target("/netbsd", ZFS_BOOT_MOUNT "/netbsd", 0);
+	if (error != 0)
+		return error;
+
+	len = sizeof modbase;
+	if (sysctlbyname("kern.module.path", modbase, &len, NULL, 0) != 0)
+		return 1;
+
+	for (i = 0; i < __arraycount(modules); i++) {
+		snprintf(moddir, sizeof moddir, "%s/%s", modbase, modules[i]);
+		snprintf(src, sizeof src, "%s/%s.kmod", moddir, modules[i]);
+		snprintf(dest, sizeof dest, "%s%s", ZFS_BOOT_MOUNT, moddir);
+		make_target_dir(dest);
+		snprintf(dest, sizeof dest, "%s%s/%s.kmod", ZFS_BOOT_MOUNT,
+		    moddir, modules[i]);
+		error = cp_within_target(src, dest, 0);
+		if (error != 0)
+			return error;
+	}
+
+	add_rc_conf("zfs=YES\n");
+	return 0;
+}
