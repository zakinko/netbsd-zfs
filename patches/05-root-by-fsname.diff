+/*
+ * "root on zfs:rpool": a root named by a file system that has a
+ * mountroot and something for it to find, rather than by a device.
+ * The file system reads the rest of the spec from rootspec, which the
+ * caller points at it.  root_device stays NULL and rootfstype names
+ * the file system, so that vfs_mountroot() asks no other.  The prefix
+ * has to name a file system known now that has a mountroot.  The other
+ * rootspecs that can hold a ':', "wedge:label" and a "NAME=label"
+ * whose label has one, begin with no such name, so they still go to
+ * parsedisk().
+ */
+static bool
+setroot_fsname(const char *spec)
+{
+	struct vfsops *vops;
+	const char *colon;
+	char fsname[VFS_NAMELEN];
+	size_t len;
+
+	if (spec == NULL || (colon = strchr(spec, ':')) == NULL)
+		return false;
+	len = colon - spec;
+	if (len == 0 || len >= sizeof(fsname) || colon[1] == '\0')
+		return false;
+	memcpy(fsname, spec, len);
+	fsname[len] = '\0';
+	if ((vops = vfs_getopsbyname(fsname)) == NULL)
+		return false;
+	if (vops->vfs_mountroot == NULL) {
+		vfs_delref(vops);
+		return false;
+	}
+	/* vfs_name lives as long as the file system does, as for NFS. */
+	rootfstype = vops->vfs_name;
+	vfs_delref(vops);
+
+	root_device = NULL;
+	rootdev = NODEV;
+	dumpdev = NODEV;
+	aprint_normal("root on %s\n", spec);
+	return true;
+}
+
