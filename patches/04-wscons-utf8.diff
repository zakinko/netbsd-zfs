+/*
+ * Draw a glyph of the wide font over this cell and the next; anything
+ * else goes to the putchar the depth installed.  Wide characters are
+ * few among the ASCII around them, so this is a plain pixel at a time
+ * for every depth rather than another set of stamp tables.
+ */
+static void
+rasops_putchar_wide(void *cookie, int row, int col, u_int uc, long attr)
+{
+	struct rasops_info *ri = (struct rasops_info *)cookie;
+	struct wsdisplay_font *font = ri->ri_wfont;
+	uint8_t *fr, *rp, *hp, *p;
+	uint32_t fg, bg, clr;
+	int width, height, x, y, ul_top, ul_bot;
