+				    fg : bg;
+			switch (ri->ri_pelbytes) {
+			case 1:
+				*p = clr;
+				break;
+			case 2:
+				*(uint16_t *)p = clr;
+				break;
+			case 3:
+				p[0] = clr >> 16;
+				p[1] = clr >> 8;
+				p[2] = clr;
+				break;
+			case 4:
+				*(uint32_t *)p = clr;
+				break;
+			}
+			p += ri->ri_pelbytes;
+		}
+		if (hp != NULL) {
+			memcpy(hp, rp, width * ri->ri_pelbytes);
+			hp += ri->ri_stride;
+		}
+		rp += ri->ri_stride;
+		fr += font->stride;
+	}
