+	rp = ri->ri_bits + FBOFFSET(ri, row, col);
+	hp = ri->ri_hwbits ? ri->ri_hwbits + FBOFFSET(ri, row, col) : NULL;
+	/* not FONT_GLYPH(): ri_fontscale is the text font's glyph size */
+	fr = (uint8_t *)font->data +
+	    (uc - font->firstchar) * height * font->stride;
