+#undef	SYSCTL_VERSION
+#define	SYSCTL_VERSION		SYSCTL_VERS_1
+#undef	SYSCTL_NAMELEN
+#define	SYSCTL_NAMELEN		SYSCTL_NAMELEN_V1
+#define	sysctlnode		sysctlnode_v1
+#undef	sysctlgetmibinfo
+#define	sysctlgetmibinfo	__compat_sysctlgetmibinfo
+#undef	__learn_tree
+#define	__learn_tree		__compat___learn_tree
+
+int	__compat_sysctlgetmibinfo(const char *, int *, u_int *,
+	    char *, size_t *, struct sysctlnode_v1 **, int);
+int	__compat___learn_tree(int *, u_int, struct sysctlnode_v1 *);
+
+#define	__SYSCTL_COMPAT_V1
+
+#include "gen/sysctlgetmibinfo.c"
