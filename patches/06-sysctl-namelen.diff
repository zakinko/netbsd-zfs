+__warn_references(sysctlgetmibinfo,
+    "warning: reference to compatibility sysctlgetmibinfo(); include <sys/sysctl.h> for correct reference")
+__warn_references(__learn_tree,
+    "warning: reference to compatibility __learn_tree(); include <sys/sysctl.h> for correct reference")
+#endif
