diff --git a/usr.sbin/sysinst/util.c b/usr.sbin/sysinst/util.c
index ebc1272..dbdcb19 100644
--- a/usr.sbin/sysinst/util.c
+++ b/usr.sbin/sysinst/util.c
@@ -252,12 +252,13 @@ init_set_status(int flags)
 	msg_none = msg_string(MSG_None);
 
 	/* Find longest and use it to determine width of selection menu */
-	len = strlen(msg_no); longest = msg_no;
-	i = strlen(msg_yes); if (i > len) {len = i; longest = msg_yes; }
-	i = strlen(msg_all); if (i > len) {len = i; longest = msg_all; }
-	i = strlen(msg_some); if (i > len) {len = i; longest = msg_some; }
-	i = strlen(msg_none); if (i > len) {len = i; longest = msg_none; }
-	select_menu_width = snprintf(NULL, 0, "%-40s %s", "", longest);
+	/* in columns, for the sake of the translations - see set_label() */
+	len = msg_strwidth(msg_no); longest = msg_no;
+	i = msg_strwidth(msg_yes); if (i > len) {len = i; longest = msg_yes; }
+	i = msg_strwidth(msg_all); if (i > len) {len = i; longest = msg_all; }
+	i = msg_strwidth(msg_some); if (i > len) {len = i; longest = msg_some; }
+	i = msg_strwidth(msg_none); if (i > len) {len = i; longest = msg_none; }
+	select_menu_width = 40 + 1 + msg_strwidth(longest);
 
 	/* Give the md code a chance to choose the right kernel, etc. */
 	md_init_set_status(flags);
@@ -864,7 +865,7 @@ set_label(menudesc *menu, int opt, void *arg)
 	distinfo *dist = distp[opt];
 	const char *selected;
 	const char *desc;
-	int nested;
+	int nested, pad;
 
 	desc = dist->desc;
 
@@ -897,7 +898,15 @@ set_label(menudesc *menu, int opt, void *arg)
 		}
 	}
 
-	wprintw(menu->mw, "%-40s %s", msg_string(desc), selected);
+	/*
+	 * Pad to the column, in columns rather than bytes: a translation
+	 * in UTF-8 has more of the latter and the right hand side would
+	 * come out ragged.
+	 */
+	wprintw(menu->mw, "%s", msg_string(desc));
+	for (pad = msg_strwidth(msg_string(desc)); pad < 40; pad++)
+		waddch(menu->mw, ' ');
+	wprintw(menu->mw, " %s", selected);
 }
 
 static int set_sublist(menudesc *menu, void *arg);
