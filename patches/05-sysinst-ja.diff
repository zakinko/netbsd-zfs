diff --git a/usr.sbin/sysinst/main.c b/usr.sbin/sysinst/main.c
index c851998..6a121e3 100644
--- a/usr.sbin/sysinst/main.c
+++ b/usr.sbin/sysinst/main.c
@@ -92,6 +92,7 @@ char dist_tgz_postfix[SSTRSIZE];
 WINDOW *mainwin;
 
 static void select_language(const char*);
+static void reopen_screen(void);
 __dead static void usage(void);
 __dead static void miscsighandler(int);
 static void ttysighandler(int);
@@ -444,6 +445,25 @@ select_language(const char *msg_cat_path)
 	if (found.num_lang <= 1)
 		goto done;
 
+	/*
+	 * Sort the catalogs by file name, so that the menu comes out in
+	 * the same order on every medium; readdir() order does not.  The
+	 * built-in language stays first.
+	 */
+	for (lang = 2; lang < found.num_lang; lang++) {
+		char *fname = found.fnames[lang];
+		char *lmsg = found.lang_msg[lang];
+		int i;
+
+		for (i = lang;
+		    i > 1 && strcmp(found.fnames[i - 1], fname) > 0; i--) {
+			found.fnames[i] = found.fnames[i - 1];
+			found.lang_msg[i] = found.lang_msg[i - 1];
+		}
+		found.fnames[i] = fname;
+		found.lang_msg[i] = lmsg;
+	}
+
 	opt = calloc(found.num_lang, sizeof *opt);
 	if (!opt)
 		goto done;
@@ -477,7 +497,73 @@ select_language(const char *msg_cat_path)
 	if (cp) {
 		setlocale(LC_CTYPE, cp);
 		setenv("LC_CTYPE", cp, 1);
+		/*
+		 * A UTF-8 catalog needs the terminal to decode UTF-8 as
+		 * well.  wscons(4) only does so after ESC % G (ISO 2022);
+		 * other terminals ignore or already honour it.
+		 */
+		if (strstr(cp, "UTF-8") != NULL) {
+			reopen_screen();
+			write(STDOUT_FILENO, "\033%G", 3);
+		}
+	}
+}
+
+/*
+ * Start curses over on a fresh stdout stream.
+ *
+ * A stream keeps the multibyte state of the locale it first wrote a
+ * wide character in, and curses drew the language menu in the C
+ * locale.  Once LC_CTYPE is UTF-8, wcrtomb() with that state fails
+ * with EILSEQ and curses drops the character, so the catalog would
+ * come out as its ASCII parts only.  Only a new FILE clears it, and
+ * curses takes one at newterm(), hence the new screen.
+ */
+static void
+reopen_screen(void)
+{
+	FILE *out;
+	SCREEN *scr, *old;
+
+	if (!isatty(STDOUT_FILENO))
+		return;
+	out = fdopen(dup(STDOUT_FILENO), "w");
+	if (out == NULL)
+		return;
+	endwin();
+	scr = newterm(NULL, out, stdin);
+	if (scr == NULL) {
+		/* carry on with the screen we have */
+		fclose(out);
+		refresh();
+		return;
+	}
+	delwin(mainwin);
+	old = set_term(scr);
+	cbreak();
+	noecho();
+	mainwin = newwin(getmaxy(stdscr) - 2, getmaxx(stdscr) - 2, 1, 1);
+	if (has_colors()) {
+		start_color();
+		do_coloring(clr_arg.fg, clr_arg.bg);
 	}
+	msg_window(mainwin);
+	/*
+	 * What the old screen drew is still on the display and the new
+	 * one has no idea of it, so ask for the whole thing to be drawn
+	 * again.  Without this, cells it believes are already right keep
+	 * the old text, and the wide characters of the new one land in
+	 * the middle of it.
+	 */
+	clearok(curscr, TRUE);
+	touchwin(stdscr);
+	refresh();
+	/*
+	 * delscreen(old) after set_term() crashes inside libcurses; the
+	 * old screen is a few kB and this happens once, so it is left
+	 * allocated.
+	 */
+	(void)old;
 }
 
