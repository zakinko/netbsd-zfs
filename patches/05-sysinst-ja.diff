+/*
+ * Columns a string takes on the screen.  A catalog in UTF-8 has more
+ * bytes than columns, so strlen() overestimates and boxes come out too
+ * wide; when the string does not convert in the current locale, fall
+ * back to it.
+ */
+int
+msg_strnwidth(const char *s, size_t len)
+{
+	wchar_t wc;
+	mbstate_t st;
+	size_t n;
+	int w, cw;
+
+	memset(&st, 0, sizeof(st));
+	for (w = 0; len > 0; s += n, len -= n, w += cw) {
+		n = mbrtowc(&wc, s, len, &st);
+		if (n == (size_t)-1 || n == (size_t)-2 || n == 0)
+			return w + len;
+		cw = wcwidth(wc);
+		if (cw < 0)
+			cw = 1;
+	}
+	return w;
+}
+
+int
+msg_strwidth(const char *s)
+{
+
+	return msg_strnwidth(s, strlen(s));
+}
