 static void efi_heap_init(void);
 
+#ifdef SUPPORT_ZFS
+/*
+ * A file written with large_blocks has records of up to 16MB, and ZFS
+ * holds one twice over while reading it, and more to rebuild it on
+ * raidz.  The heap is not grown for that: it is taken before
+ * efi_memory_probe() reserves the kernel's load space, and a heap large
+ * enough would leave a smaller machine no room to load any kernel at
+ * all.  Such a record's buffers come from the firmware as it is read,
+ * and go back as soon as it has been.
+ */
+static void *
+efi_zfs_bigalloc(size_t len)
+{
+	EFI_PHYSICAL_ADDRESS pa = EFI_ALLOCATE_MAX_ADDRESS;
+	EFI_STATUS status;
+
+	status = uefi_call_wrapper(BS->AllocatePages, 4, AllocateMaxAddress,
+	    EfiLoaderData, EFI_SIZE_TO_PAGES(len), &pa);
+	if (EFI_ERROR(status))
+		return NULL;
+	return (void *)(UINTN)pa;
+}
+
+static void
+efi_zfs_bigfree(void *p, size_t len)
+{
+
+	uefi_call_wrapper(BS->FreePages, 2, (EFI_PHYSICAL_ADDRESS)(UINTN)p,
+	    EFI_SIZE_TO_PAGES(len));
+}
+#endif
