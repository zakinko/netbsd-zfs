@@ -48,3 +48,18 @@
 #define	SAIOGBADINFO	(('d'<<8)|14)	/* get bad-sector table */
 
 #define SAIOSECSIZE	(('d'<<8)|15)	/* get sector size */
+#define SAIODEVSIZE	(('d'<<8)|16)	/* get device size in bytes */
+#define SAIODEVPEER	(('d'<<8)|17)	/* open another device, by number */
+
+/*
+ * SAIODEVPEER: open device sp_index of those the driver can reach on
+ * sp_file, which the caller allocates and later closes.  ENOENT once
+ * the number is past the last; any other error is a device that could
+ * not be opened, and the next number may still work.  For a file
+ * system that spans devices, such as a ZFS pool on several disks.
+ */
+struct open_file;
+struct saiodevpeer {
+	int			sp_index;
+	struct open_file	*sp_file;
+};
